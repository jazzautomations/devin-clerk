{
  "name": "devin-clerk",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "share": "bash scripts/share.sh",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "scrape": "uv run --python .venv-scraper/bin/python scripts/scrape_radar.py",
    "test:scrape": "uv run --python .venv-scraper/bin/python scripts/test_scrape_radar.py",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:e2e": "node tests/e2e/reset-db.mjs && DATABASE_URL=$E2E_DATABASE_URL HACKAHUB_DIST_DIR=.next-e2e npx next build",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@clerk/localizations": "^4.23.0",
    "@clerk/nextjs": "^7.9.10",
    "@electric-sql/pglite": "^0.5.9",
    "@pdf-lib/fontkit": "^1.1.1",
    "jsqr": "^1.4.0",
    "next": "16.4.3",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
