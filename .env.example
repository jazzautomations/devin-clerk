# Written automatically by `npx -y clerk@latest init` into .env.local — never commit real values.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Base pública do site p/ SEO (canonical, OG, sitemap, robots) — ver lib/seo.ts.
# Sem ela, cai no placeholder https://hackahub.dev — trocar pela URL real em produção.
NEXT_PUBLIC_SITE_URL=https://hackahub.dev
# Segredo do HMAC que assina o QR do ingresso (lib/checkins.ts). Obrigatório
# em produção/staging (sem ele a página de ingresso e o check-in dão erro);
# em dev/teste cai num default explícito. Gere com: openssl rand -base64 32
# Trocar o segredo invalida todos os QRs já emitidos.
HACKAHUB_TICKET_SECRET=

# Avisos da edição (spec 033 US2). Sem a env do canal o driver é "log":
# marca a entrega como pulada e não manda nada (dev/teste).
RESEND_API_KEY=
HACKAHUB_EMAIL_FROM="Hack Inova <avisos@seu-dominio>"
# e-mail real da organização que recebe as respostas (o remetente acima
# costuma ser um endereço que ninguém lê). Sem ele, nenhum e-mail pede
# "responda este e-mail".
HACKAHUB_EMAIL_REPLY_TO=
# webhook do Resend (bounce) — "whsec_..." do painel do Resend
RESEND_WEBHOOK_SECRET=
EVOLUTION_URL=
EVOLUTION_INSTANCE=
EVOLUTION_API_KEY=
# cron reprocessa a fila: POST /api/cron/deliveries com Authorization: Bearer <isto>
HACKAHUB_CRON_SECRET=

# Dossiê de evidência (migration 029): lê commits de repositório público do
# GitHub. Opcional: sem token o limite é 60 consultas por hora por IP; com
# um token sem escopo nenhum (fine-grained, só leitura pública) sobe pra 5.000.
GITHUB_TOKEN=
